# pyenv
#   For a library or binary, you shouldn't check in the .python-version file.
#   For an application, you might.
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if you choose not to, uncomment the following line:
# Pipfile.lock

# poetry
#   Similar to Pipfile.lock, it is generally recommended to include poetry.lock in version control.
#   Poetry doesn't have a specific recommendation on this.
# poetry.lock

# pdm
#   Similar to Pipfile.lock, it is generally recommended to include pdm.lock in version control.
# pdm.lock
#   pdm env set up a virtual environment in .venv by default
.venv/

