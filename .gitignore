# Re-include config files that the broad *.json / *.csv rules above would hide
!**/package.json
!**/package-lock.json
!**/tsconfig.json
!**/tsconfig.*.json
!**/next.config.*
!**/components.json
!**/.eslintrc.json
!**/postcss.config.*
!apps/**/public/**
!data/**/README.md
!data/.gitkeep
!data/maps/
!data/maps/*.json
!packages/absa_core/absa_core/models/thresholds.json
# Promoted-artifact config/metadata (thresholds, HF encoder config, tokenizer_config) — the
# *.pt/*.onnx weight files stay ignored above; only these small JSON/text files are tracked
# so a fresh clone has a structurally complete (if weight-less) artifacts/final|ensemble tree.
!artifacts/final/**/*.json
!artifacts/ensemble/**/*.json

# SentenAI Unified reproducibility inputs. The provided raw v3 dataset is intentionally
# versioned in this project copy; generated split rows stay local, while the manifest may
# be committed after `make prepare` to freeze a benchmark release.
!data/
data/*
!data/.gitkeep
!data/maps/
!data/maps/*.json
!data/raw/
data/raw/*
!data/raw/tiki-book-review_merged_fixed_v3.json
!data/splits/
data/splits/*
!data/splits/README.md
!data/splits/split_manifest.json
!packages/absa_core/absa_core/data/
!packages/absa_core/absa_core/data/maps/
!packages/absa_core/absa_core/data/maps/*.json

