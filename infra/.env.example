# Prefer the model promoted by the fair benchmark when present.
ABSA_PREFER_UNIFIED_ARTIFACT=1
ABSA_ARTIFACT_DIR=artifacts/final

# Copy to infra/.env and fill in before running:
#   docker compose -f infra/docker-compose.yml up --build

# Required — generate with: openssl rand -hex 32
# The API refuses to start with the placeholder default when ENVIRONMENT=production
# (see apps/api/app/main.py::_check_jwt_secret).
JWT_SECRET=

# "production" (default for this compose stack) enforces the JWT_SECRET check above.
# Set to "development" only for local throwaway runs where that guard gets in the way.
ENVIRONMENT=production

# Optional local MLOps profile (`docker compose --profile mlops ...`)
MLFLOW_TRACKING_URI=http://localhost:5000
