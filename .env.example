# ── SentenAI — environment template. Copy to `.env` and fill in. ──

# ABSA model. Leave default to auto-download from HuggingFace on first run.
# Prefer the model promoted by the fair benchmark when present.
ABSA_PREFER_UNIFIED_ARTIFACT=1
ABSA_ARTIFACT_DIR=artifacts/final

ABSA_MODEL_ID=hoangloc112/ABSA-TIKI-BOOK
ABSA_MODEL_VARIANT=phobert
# ABSA_OFFLINE=0          # set 1 to force local-only model loading
# ABSA_MODEL_DIR=         # optional explicit path to a local model dir

# JWT Authentication
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

# Database (shop/user auth). Defaults to SQLite for local dev.
DATABASE_URL=sqlite:///./data/app.db
# DATABASE_URL=postgresql+psycopg://sentinel:sentinel@localhost:5432/sentinel

# API server
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated origins allowed to call the API (the web app).
CORS_ORIGINS=http://localhost:3000

# Web app (apps/web) — base URL of the FastAPI gateway.
NEXT_PUBLIC_API_URL=http://localhost:8000
